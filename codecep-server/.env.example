# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT TEMPLATE — copy to `.env.local` and fill in real values.
#
#   cp .env.example .env.local
#
# `.env.local` is the ACTIVE local file and is gitignored (it holds the real
# local Postgres password). `src/env.ts` loads `.env.local` first, then falls
# back to `.env` for an older checkout, and never overwrites a variable that is
# already set in the environment — which is what lets production (Heroku config
# vars) use the SAME codebase with no file at all. See `.env.production` for the
# production template.
# ─────────────────────────────────────────────────────────────────────────────

# Heroku assigns PORT at boot; the server reads process.env.PORT and falls back
# to 3001, so this line is what pins local dev to the usual port.
PORT=3001

# Which browser origins may call this server (gap #61). Comma-separated, matched
# EXACTLY on the full origin. This is now genuinely enforced for BOTH the HTTP
# API and the Socket.io handshake — before deploy prep it was set here but read
# by neither.
#
# UNSET (or empty) falls back to allowing any `http://localhost` origin, which
# is the permissive local-dev default. Pinning it to :5173 as below is stricter
# and matches vite's normal port — if vite ever falls back to :5174 (because
# 5173 is taken), either use that port or comment this line out.
CORS_ORIGIN="http://localhost:5173"

# Native local PostgreSQL 16 on localhost:5432 (NOT Docker). Does not
# auto-suspend, so the ETIMEDOUT class that Neon produced does not occur here.
DATABASE_URL="postgresql://codecep:<your-local-password>@localhost:5432/codecep"

# Managed-Postgres fallback, kept commented so it can be switched back to by
# swapping which DATABASE_URL line is active. Paste the URL from the provider's
# dashboard; it is not stored in the repo.
# DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"

# Local Redis (docker container `codecep-redis`). The BullMQ forensics worker
# needs a REAL Redis — never stub it.
REDIS_URL="redis://localhost:6379"

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here-change-in-production

# Gemini (syllabus → per-week allowlist). Required: the server throws at startup
# if it is missing.
GEMINI_API_KEY=your-gemini-api-key

# Per-request debug traces ([SESSION]/[INGEST]/[AST]/[EXECUTE]/[RELAY]/[SOCKET]).
# DEBUG=true

# Only with a real reverse proxy in front (see CLAUDE.md gap #45).
# TRUST_PROXY=true

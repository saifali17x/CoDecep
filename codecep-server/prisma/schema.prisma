generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id            String   @id @default(uuid())
  studentId     String
  status        String   @default("IN_PROGRESS")
  playback_log  Json     @default("[]")
  burst_history Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sessions")
}

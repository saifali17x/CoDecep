generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id               String   @id @default(uuid())
  studentId        String
  status           String   @default("IN_PROGRESS")
  playback_log     Json     @default("[]")
  burst_history    Json     @default("[]")
  forensicsResults Json?
  // Session 22 (part 2) — Tier-1 alert record: [{ type, timestamp, detail }].
  // Deliberately NULLABLE with NO default so a NULL means "this session predates
  // the feature" while [] means "recorded, nothing fired". Session create sets
  // it to []; the socket relay appends while the session is IN_PROGRESS.
  tier1_log        Json?
  runCount         Int      @default(0)
  // Multi-task exams (Prompt 2) — how many times the student ran EACH task:
  // { task1: 3, task2: 1 }. Metric A is a compile count, and on a multi-task
  // exam each task is a separate program, so one session-level scalar could
  // never say which question was iterated on. `runCount` above stays the
  // session TOTAL (unchanged, every existing reader keeps working).
  //
  // Deliberately NULLABLE with NO default, the same discipline as tier1_log:
  // NULL means "this session predates per-task run tracking" — the report then
  // falls back to the session total rather than claiming a task ran zero times.
  runCountByTask   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId       String?
  assignmentId String?
  user         User?       @relation(fields: [userId], references: [id])
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  @@map("sessions")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String // 'INSTRUCTOR' | 'STUDENT'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taughtClasses Class[]           @relation("InstructorClasses")
  memberships   ClassMembership[]
  sessions      Session[]

  @@map("users")
}

model Class {
  id           String   @id @default(uuid())
  name         String
  joinCode     String   @unique
  instructorId String
  instructor   User     @relation("InstructorClasses", fields: [instructorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // The COURSE syllabus (uploaded once per class, re-uploadable mid-semester)
  // and the instructor-confirmed per-week AST allowlist Gemini parsed from it.
  // Assignments link to it by week — see Session 20 in CLAUDE.md.
  syllabusFilename String?
  allowlist        Json? // { weeks: { week1: [...], ... } }

  memberships ClassMembership[]
  assignments Assignment[]

  @@map("classes")
}

model ClassMembership {
  id       String   @id @default(uuid())
  userId   String
  classId  String
  user     User     @relation(fields: [userId], references: [id])
  class    Class    @relation(fields: [classId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([userId, classId])
  @@map("class_memberships")
}

model Assignment {
  id      String @id @default(uuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id])
  title   String
  type    String // 'LIVE_LAB' | 'ASSESSMENT'
  week    Int    @default(1) // which week's class allowlist applies

  // Multi-task exams (Prompt 1). How many questions this exam has: the student
  // gets one file workspace per task and ONE submit covers all of them. Default
  // 1 == the pre-multi-task behavior, so every existing assignment is unchanged.
  // Tasks themselves are NOT a table — they are a dimension inside the session
  // JSONB (taskId on events, taskSnapshots per flush). This column is the only
  // structural fact that has to outlive a session.
  taskCount Int @default(1)

  // The TASK/QUESTION document students read in the exam split-pane.
  // (Session 20: this was `pdfFilename`, which used to double as the syllabus.
  // The syllabus + allowlist now live on Class.)
  assignmentPdfFilename String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  @@map("assignments")
}
